# Copy outside the release directory; fill secrets only on the API server.
NODE_ENV=production
API_PORT=4318
LIGHTMAO_DATA_DIR=/var/lib/lightmao
LIGHTMAO_DEMO=false
LIGHTMAO_PERMISSION_MODE=full
LIGHTMAO_ADMIN_EMAIL=
LIGHTMAO_ADMIN_PASSWORD=
LIGHTMAO_SECURE_COOKIES=true
LIGHTMAO_TRUST_PROXY=loopback
LIGHTMAO_WEB_ORIGINS=https://agent.example.com
LIGHTMAO_STORAGE=local
ARK_API_KEY=
ARK_MODEL_ID=deepseek-v4-1-flash-261017
ARK_CONTEXT_WINDOW_TOKENS=1024000
ARK_MAX_OUTPUT_TOKENS=128000
ARK_VISION_MODEL_ID=doubao-seed-evolving
ARK_AUDIO_MODEL_ID=doubao-seed-2-1-lite-260915
ARK_SYSTEM_ONE_MODEL_ID=doubao-seed-2-1-lite-260915
ARK_IMAGE_MODEL_ID=doubao-seedream-5-0-pro-260628
ARK_VIDEO_MODEL_ID=doubao-seedance-2-5-260628
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# For OSS, set LIGHTMAO_STORAGE=oss and configure a dedicated prefix.
OSS_REGION=oss-cn-beijing
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=lightmao/v1/

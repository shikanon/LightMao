# Install inside nginx's http context after replacing host/certificate paths.
# This template does not acquire certificates or alter existing virtual hosts.
server {
    listen 80;
    server_name agent.example.com;
    return 308 https://agent.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name agent.example.com;
    ssl_certificate /etc/letsencrypt/live/agent.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agent.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 22m;

    # Access logging is disabled for this vhost; keep operational logs private.
    access_log off;
    error_log /var/log/nginx/lightmao-error.log warn;

    location / {
        proxy_pass http://127.0.0.1:4318;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 210s;
        proxy_send_timeout 210s;
        proxy_next_upstream off;
    }
}

# Server secrets stay on the API server. Never prefix secrets with VITE_.
ARK_API_KEY=
ARK_MODEL_ID=deepseek-v4-1-flash-261017
ARK_CONTEXT_WINDOW_TOKENS=1024000
ARK_MAX_OUTPUT_TOKENS=128000
ARK_SYSTEM_ONE_MODEL_ID=doubao-seed-2-1-lite-260915
ARK_IMAGE_MODEL_ID=doubao-seedream-5-0-pro-260628
ARK_VIDEO_MODEL_ID=doubao-seedance-2-5-260628
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
API_PORT=4318
AGENT_PORT=4319
LIGHTMAO_API_URL=http://127.0.0.1:4318
# A loopback-only demo login is available in development. Disable for deployment.
LIGHTMAO_DEMO=true
# Registered built-in tools start enabled. Explicit per-account choices persist across restarts.
# This does not change OS permissions, install external plugins, or execute tasks.
LIGHTMAO_PERMISSION_MODE=full
ARK_VISION_MODEL_ID=doubao-seed-evolving
ARK_AUDIO_MODEL_ID=doubao-seed-2-1-lite-260915
# Set these before deployment to create the first administrator.
LIGHTMAO_ADMIN_EMAIL=
LIGHTMAO_ADMIN_PASSWORD=
LIGHTMAO_SECURE_COOKIES=false
LIGHTMAO_WEB_ORIGINS=http://127.0.0.1:4317,http://localhost:4317
# Set only behind a trusted local reverse proxy; API remains loopback-only.
# LIGHTMAO_TRUST_PROXY=loopback
# For production use deploy/server.env.example and NODE_ENV=production.
# Persistent data defaults to <repository>/.lightmao
LIGHTMAO_DATA_DIR=
# Optional fixed local engine path. This is not a credential and is never sent to the model.
# LIGHTMAO_GODOT_PATH=/absolute/path/Godot.app
# Optional local recording decoder; required when FFmpeg is not installed in a detected location.
# LIGHTMAO_FFMPEG_PATH=/absolute/path/ffmpeg
# Optional isolated Electron profile (distinct from the Agent data directory).
# LIGHTMAO_USER_DATA_DIR=/absolute/path/desktop-profile
# Packaged desktop configures its backend in the UI and keeps a separate
# Application Support/LightMao Desktop profile. Server secrets never go there.
# Cloud drive: local or oss. Only the API process receives these variables.
LIGHTMAO_STORAGE=local
OSS_REGION=oss-cn-beijing
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=lightmao/v1/
DOUBAO_VOICE_API_KEY=

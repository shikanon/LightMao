{
  "name": "lightmao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "apps/desktop/main.cjs",
  "files": [
    "apps/desktop",
    "dist/agent",
    "dist/runtime",
    "dist/plugins",
    "dist/examples",
    "dist/web",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx apps/api/index.ts",
    "dev:agent": "tsx apps/agent/index.ts",
    "desktop": "node scripts/desktop.mjs",
    "package:desktop": "pnpm build && node scripts/package-desktop.mjs",
    "test:installed": "node --import tsx scripts/qa-installed-desktop.mjs",
    "package:backend": "pnpm build && node scripts/package-backend.mjs",
    "test:backend": "node --import tsx scripts/qa-backend-package.mjs",
    "test:context-ui": "pnpm build && node --import tsx scripts/qa-conversation-ui.mjs",
    "test:context-desktop": "pnpm build && node --import tsx scripts/qa-conversation-ui.mjs --electron",
    "build": "node scripts/check-secrets.mjs && tsc --noEmit && vite build && node scripts/build.mjs && node scripts/check-secrets.mjs --artifacts",
    "configure:private": "node scripts/configure-private.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "guard:install": "node scripts/install-git-guards.mjs",
    "verify:skills-live": "node --import tsx scripts/verify-skills-live.mjs",
    "verify:context-live": "node --import tsx scripts/verify-context-live.mjs",
    "test:installed-system": "node scripts/verify-installed-system-live.mjs --protocol",
    "verify:installed-live": "node scripts/verify-installed-system-live.mjs",
    "test:account-ui": "pnpm build && node --import tsx scripts/qa-account-bootstrap.mjs",
    "verify:engines-live": "pnpm build && node --import tsx scripts/verify-engines-live.mjs",
    "test:engines-ui": "pnpm build && node --import tsx scripts/qa-engines-ui.mjs",
    "test:engines-desktop": "pnpm build && node --import tsx scripts/qa-engines-ui.mjs --electron",
    "test:skills-ui": "pnpm build && node --import tsx scripts/qa-skills-ui.mjs",
    "test:skills-desktop": "pnpm build && node --import tsx scripts/qa-skills-ui.mjs --electron",
    "verify:schedules-live": "node --import tsx scripts/verify-scheduled-live.mjs",
    "test:background": "pnpm build && node --import tsx scripts/qa-background-runtime.mjs",
    "test:desktop-signals": "pnpm build && node --import tsx scripts/qa-desktop-signals.mjs",
    "test:admin-ui": "pnpm build && node --import tsx scripts/qa-admin-ui.mjs",
    "test:admin-desktop": "pnpm build && node --import tsx scripts/qa-admin-ui.mjs --electron",
    "verify:live": "node --import tsx scripts/verify-live.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-runtime.mjs && tsx --test --test-concurrency=4 tests/*.test.ts",
    "test:e2e": "pnpm build && node --import tsx scripts/qa-auth-ui.mjs",
    "test:desktop": "pnpm build && node --import tsx scripts/qa-desktop.mjs",
    "test:desktop-runtime": "pnpm build && node --import tsx scripts/qa-native-runtime.mjs",
    "test:sessions-ui": "pnpm build && node --import tsx scripts/qa-sessions-ui.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start:api": "node dist/api/index.js",
    "start:agent": "node dist/agent/index.js",
    "verify:system-one-live": "node --import tsx scripts/verify-system-one-live.mjs",
    "verify:playtests-live": "node --import tsx scripts/verify-agent-upgrade-live.mjs playtests",
    "verify:games-live": "node --import tsx scripts/verify-agent-upgrade-live.mjs games",
    "verify:media-live": "node --import tsx scripts/verify-agent-upgrade-live.mjs media"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^9.0.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "ali-oss": "6.23.0",
    "fastify": "5.12.7",
    "lucide-react": "^0.577.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "three": "0.187.0",
    "typebox": "^1.1.24",
    "yaml": "2.9.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electron/packager": "20.2.0",
    "@types/ali-oss": "6.23.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "45.2.1",
    "esbuild": "^0.27.3",
    "playwright": "1.62.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  }
}
